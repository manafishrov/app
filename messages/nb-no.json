  "general_rov_settings_fluid_type_saltwater": "Saltvann",
  "general_rov_settings_smoothing_factor_title": "Utjevningsfaktor",
  "general_rov_settings_smoothing_factor_description": "Hvor mye utjevning som påføres bevegelsen til ROV. Utjevning kan være fint for å få jevn bevegelse og kamerabilder, men det kan også gjøre ROV mindre responsiv. 0 gir ingen utjevning. Ettersom verdien nærmer seg 1, øker utjevningen eksponentielt.",

  "calibration_page_title": "Kalibrering",
