<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Finds the USB-C ethernet tether to the ROV. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Controller rumble. -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!-- Keeps the ROV connection while a system file picker is open. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

  <application android:networkSecurityConfig="@xml/manafish_network_security_config">
    <service
      android:name="com.manafishrov.mobile.FilePickerService"
      android:exported="false"
      android:foregroundServiceType="shortService" />
  </application>
</manifest>
