{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manafish",
  "version": "1.0.0",
  "identifier": "com.manafish.rov",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Manafish",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "center": true,
        "width": 1200,
        "height": 675,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Manafish",
        "url": "splashscreen.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "width": 300,
        "height": 168
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3OEFGMzdGMEVFNTU3RjYKUldUMlYrVU9mL09LeDBJbktpRy91ZU9oL1RKMElNWjN6Y3B1RzhkaldsVGo3VjcwRjlubHhMUDkK",
      "endpoints": ["https://github.com/manafishrov/app/releases/latest/download/latest.json"]
    }
  }
}
