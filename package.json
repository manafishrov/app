{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/app",
  "description": "An app for controlling the Manafish ROV",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "tauri": "tauri",
    "build": "bunx vite build",
    "dev": "bunx vite",
    "fmt": "oxfmt --write src/**/*.ts src/**/*.tsx",
    "fmt:check": "oxfmt --check src/**/*.ts src/**/*.tsx",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-updater": "2.10.0",
    "@manafishrov/ui": "workspace:*",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/router-plugin": "1.163.3",
    "@tanstack/solid-form": "1.28.3",
    "@tanstack/solid-router": "1.163.3",
    "solid-js": "1.9.11",
    "idb": "8.0.3",
    "three": "0.183.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@iconify-json/ic": "1.2.4",
    "@inlang/paraglide-js": "2.13.0",
    "@types/bun": "1.3.9",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "0.15.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10",
    "tailwindcss": "4.2.1"
  }
