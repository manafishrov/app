{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/app",
  "private": true,
  "description": "An app for controlling the Manafish ROV",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "bunx vite build",
    "dev": "bunx vite",
    "fmt": "oxfmt --write src/**/*.ts src/**/*.tsx",
    "fmt:check": "oxfmt --check src/**/*.ts src/**/*.tsx",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "prepare": "lefthook install",
    "tauri": "tauri"
  },
  "dependencies": {
    "@manafishrov/ui": "1.5.0",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/router-plugin": "1.163.3",
    "@tanstack/solid-form": "1.28.5",
    "@tanstack/solid-router": "1.163.3",
    "@tanstack/solid-virtual": "3.13.21",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-updater": "2.10.0",
    "idb": "8.0.3",
    "solid-js": "1.9.11",
    "three": "0.183.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.62",
    "@inlang/paraglide-js": "2.14.0",
    "@tanstack/devtools-vite": "0.5.5",
    "@tanstack/solid-devtools": "0.7.33",
    "@tanstack/solid-router-devtools": "1.162.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/bun": "1.3.10",
    "@types/three": "0.183.1",
    "lefthook": "2.1.4",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "0.16.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10"
  }
}
