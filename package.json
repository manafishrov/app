{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/app",
  "private": true,
  "description": "An app for controlling the Manafish ROV",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "bunx vite build",
    "dev": "bunx vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rs:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -W clippy::all",
    "lint:rs:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty -- -W clippy::all",
    "prepare": "lefthook install",
    "tauri": "tauri",
    "test": "bunx vitest run"
  },
  "dependencies": {
    "@manafishrov/ui": "1.5.2",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/router-plugin": "1.167.12",
    "@tanstack/solid-form": "1.28.6",
    "@tanstack/solid-router": "1.168.9",
    "@tanstack/solid-virtual": "3.13.23",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-fs": "2.5.0",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-updater": "2.10.1",
    "idb": "8.0.3",
    "solid-js": "1.9.12",
    "three": "0.183.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.69",
    "@inlang/paraglide-js": "2.15.3",
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/solid-devtools": "0.8.2",
    "@tanstack/solid-router-devtools": "1.166.11",
    "@tauri-apps/cli": "2.10.1",
    "@types/bun": "1.3.13",
    "@types/three": "0.183.1",
    "lefthook": "2.1.5",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "vite": "8.0.8",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.5"
  }
}
