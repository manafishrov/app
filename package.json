{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/app",
  "private": true,
  "description": "An app for controlling the Manafish ROV",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "bunx vite build",
    "dev": "bunx vite",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rs:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -W clippy::all",
    "lint:rs:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty -- -W clippy::all",
    "prepare": "lefthook install",
    "tauri": "tauri",
    "test": "bunx vitest run",
    "editor:prepare": "bun scripts/preparePythonEditor.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/state": "6.7.6",
    "@lezer/highlight": "1.2.4",
    "@manafishrov/ui": "1.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@tanstack/solid-form": "1.33.5",
    "@tanstack/solid-router": "1.170.36",
    "@tanstack/solid-virtual": "3.13.40",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.16",
    "idb": "8.0.3",
    "solid-js": "1.9.15",
    "three": "0.186.0",
    "vscode-languageserver-protocol": "3.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.92",
    "@inlang/paraglide-js": "2.26.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/solid-devtools": "0.8.12",
    "@tanstack/solid-router-devtools": "1.167.2",
    "@tauri-apps/cli": "2.12.1",
    "@types/bun": "1.4.2",
    "@types/three": "0.186.0",
    "@typescript/typescript6": "6.0.2",
    "happy-dom": "20.14.5",
    "lefthook": "2.1.14",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2002",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unplugin-auto-import": "21.1.0",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  }
}
